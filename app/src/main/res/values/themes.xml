<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="mindtrack_night">#090D1B</color>

    <style name="Theme.MindTrack" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mindtrack_night</item>
    </style>

    <style name="WidgetFace">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">26sp</item>
        <item name="android:padding">4dp</item>
    </style>
</resources>
